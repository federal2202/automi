generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  googleId     String   @unique
  email        String   @unique
  name         String
  picture      String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  // Bumped on logout so a previously-issued refresh JWT (valid up to 7 days)
  // is rejected by /auth/refresh even though its signature still checks out —
  // the only revocation mechanism available without a separate token-blacklist
  // store. Access tokens are short-lived (30 min) and are not checked against
  // this, which is an accepted tradeoff: a stolen access token self-expires
  // quickly regardless.
  tokenVersion Int      @default(0)
  timezone               String    @default("UTC")
  onboardingCompletedAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt    DateTime @updatedAt
  tasks        Task[]
  periods      Period[]
  recurringActivities RecurringActivity[]
  syncedEvents SyncedEvent[]

  @@map("users")
}

model Period {
  id        String   @id @default(cuid())
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringActivities RecurringActivity[]

  @@index([userId, startDate])
  @@map("periods")
}

model RecurringActivity {
  id        String   @id @default(cuid())
  periodId  String
  userId    String
  title     String
  schedule  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodId])
  @@map("recurring_activities")
}

model SyncedEvent {
  id            String   @id @default(cuid())
  userId        String
  googleEventId String
  sourceType    String
  sourceId      String
  date          DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, date])
  @@index([userId])
  @@map("synced_events")
}

model Task {
  id                   String   @id @default(uuid())
  title                String
  eventId              String
  description          String
  estimatedTimeMinutes Int
  difficulty           String
  steps                Json
  resources            Json?
  successCriteria      String
  isDone               Boolean  @default(false)
  aiStatus             String   @default("pending")
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tasks")
}
